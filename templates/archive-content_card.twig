{% extends 'templates/_document.twig' %}

{% block content %}

	<section class="py-16 bg-gray-50">
		<div
			class="container mx-auto px-4">

			{# === HEADER-BEREICH === #}
			{% include "templates/_partials/headings.twig" with {
			title: archive_title,
			description: archive_description,
			textAlign: 'text-center'
		} only %}

			{# === KATEGORIE-FILTER === #}
			{% if categories %}
				<div
					class="flex flex-wrap justify-center gap-3 mb-12">
					{# "Alle" Button #}
					<a href="{{ archive_url }}" class="px-6 py-2 rounded-full font-medium transition-all duration-300 {% if not current_category %}bg-primary text-white{% else %}bg-white text-gray-700 hover:bg-gray-100{% endif %}">
						Alle
					</a>

					{# Kategorie-Buttons #}
					{% for category in categories %}
						<a href="{{ category.link }}" class="px-6 py-2 rounded-full font-medium transition-all duration-300 {% if current_category and current_category.slug == category.slug %}bg-primary text-white{% else %}bg-white text-gray-700 hover:bg-gray-100{% endif %}">
							{{ category.name }}
						</a>
					{% endfor %}
				</div>
			{% endif %}

			{# === GRID MIT KARTEN === #}
			{% if posts %}
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{% for post in posts %}
						{# --- DATEN VORBEREITUNG --- #}
						{% set imageId = post.meta('image') ?: post.thumbnail.id %}
						{% set itemDate = post.meta('date') ?: post.date %}
						{% set itemTagline = post.meta('tagline') %}
						{% set itemTitle = post.meta('title') ?: post.title %}
						{% set itemDesc = post.meta('description') ?: post.preview.length(20).read_more(false) %}

						{# Link #}
						{% set acfLink = post.meta('link') %}
						{% set linkUrl = acfLink.url ?? post.link %}
						{% set linkTarget = acfLink.target ?? '_self' %}
						{% set linkText = acfLink.title ?? 'Mehr erfahren' %}

						{# --- KARTE --- #}
						<article class="bg-white rounded-xl shadow-md overflow-hidden flex flex-col h-full hover:shadow-xl transition-all duration-300 hover:-translate-y-1 group">

							<a href="{{ linkUrl }}" target="{{ linkTarget }}" class="block overflow-hidden aspect-video bg-gray-200 relative">
								{% if imageId %}
									<img class="h-full w-full object-cover group-hover:scale-[1.03] transition-transform duration-500" src="{{ Image(imageId).src }}" srcset="{{ Image(imageId).srcset }}" alt="{{ itemTitle }}" loading="lazy">
								{% else %}
									<div class="flex items-center justify-center h-full text-gray-400 bg-gray-100 font-medium">
										Bild fehlt
									</div>
								{% endif %}
							</a>

							<div class="p-6 grow flex flex-col">

								{% if itemDate or itemTagline %}
									<div class="flex items-center justify-between gap-3 mb-4">
										{% if itemTagline %}
											<p class="text-sm font-normal bg-primary w-fit py-1 px-2 rounded-2xl text-white">
												{{ itemTagline }}
											</p>
										{% endif %}

										{% if itemDate %}
											<p class="text-sm text-gray-500 ml-auto">
												{{ itemDate|date("d.m.Y") }}
											</p>
										{% endif %}
									</div>
								{% endif %}

								<h3 class="text-xl font-bold text-gray-900 mb-3">
									<a href="{{ linkUrl }}" target="{{ linkTarget }}" class="hover:text-primary transition-colors">
										{{ itemTitle }}
									</a>
								</h3>

								<div class="text-gray-600 prose prose-sm max-w-none mb-6 grow">
									{{ itemDesc }}
								</div>

								<div class="mt-auto pt-4 border-t border-gray-100">
									{% include "templates/_partials/button.twig" with {
									link: linkUrl,
									text: linkText,
									variant: 'outlined',
								} only %}
								</div>

							</div>
						</article>

					{% endfor %}
				</div>

				{# === PAGINATION === #}
				{% if pagination and pagination.pages|length > 1 %}
					<nav class="mt-12 flex justify-center" aria-label="Seitennavigation">
						<div class="flex gap-2">
							{% if pagination.prev %}
								<a href="{{ pagination.prev.link }}" class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
									← Zurück
								</a>
							{% endif %}

							{% for page in pagination.pages %}
								{% if page.link %}
									<a href="{{ page.link }}" class="px-4 py-2 rounded-lg transition-colors
																																																															          {% if page.current %}bg-primary text-white font-bold{% else %}bg-white border border-gray-300 hover:bg-gray-50{% endif %}">
										{{ page.title }}
									</a>
								{% else %}
									<span class="px-4 py-2 text-gray-400">...</span>
								{% endif %}
							{% endfor %}

							{% if pagination.next %}
								<a href="{{ pagination.next.link }}" class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
									Weiter →
								</a>
							{% endif %}
						</div>
					</nav>
				{% endif %}

			{% else %}
				<p class="text-center text-gray-500 py-12 text-lg">
					Noch keine Content-Karten vorhanden.
				</p>
			{% endif %}

		</div>
	</section>

{% endblock %}
