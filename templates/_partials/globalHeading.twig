{% set textAlign = textAlign|default('text-start') %}
{% set isSplit = textAlign == 'text-split' %}
{% set isTextCenter = textAlign == 'text-center' %}
{% set descriptionClass =
  'prose lg:prose-lg prose-li:marker:text-current prose-p:text-xl prose-a:text-current prose-strong:text-current prose-blockquote:text-current prose-headings:text-current max-w-none'
%}

{% if isSplit %}
  <div class="flex flex-row items-start gap-16 pb-12">
    <div class="flex flex-1 flex-col">
      {% if tag %}
        <span class="bg-primary self-start px-3 py-1 text-white">{{ tag|e }}</span>
      {% endif %}
      {% if title %}
        {% if heading_level == 'h1' %}
          <h1 class="heading-xl">{{ title|e }}</h1>
        {% elseif heading_level == 'h3' %}
          <h3 class="heading-xl">{{ title|e }}</h3>
        {% else %}
          <h2 class="heading-xl">{{ title|e }}</h2>
        {% endif %}
      {% endif %}
    </div>
    {% if description or buttons %}
      <div class="flex flex-1 flex-col justify-center">
        {% if description %}
          <div class="{{ descriptionClass }}">
            {{ description|e('wp_kses_post') }}
          </div>
        {% endif %}
        {% if buttons %}
          <div class="flex gap-4 pt-8 md:flex-row">
            {% for button in buttons %}
              {% include 'templates/_partials/button.twig' with {
                text: button.text,
                link: button.link,
                target: button.target,
                variant: loop.first ? 'primary' : 'outlined'
              } only %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
{% else %}
  <div class="flex flex-col pb-12 {{ textAlign }}">
    {% if tag %}
      <span class="heading-2xs text-primary/50 pb-3.5 uppercase">{{ tag|e }}</span>
    {% endif %}

    {% if title %}
      {% if heading_level == 'h1' %}
        <h1 class="heading-xl pb-6">{{ title|e }}</h1>
      {% elseif heading_level == 'h3' %}
        <h3 class="heading-xl pb-6">{{ title|e }}</h3>
      {% else %}
        <h2 class="heading-xl pb-6">{{ title|e }}</h2>
      {% endif %}
    {% endif %}

    {% if description %}
      <div class="{{ descriptionClass }} {% if isTextCenter %}self-center w-[80%]{% endif %}">
        {{ description|e('wp_kses_post') }}
      </div>
    {% endif %}

    {% if buttons %}
      <div
        class="{% if isTextCenter %}justify-center{% else %}justify-start{% endif %} flex gap-4 pt-8 md:flex-row"
      >
        {% for button in buttons %}
          {% include 'templates/_partials/button.twig' with {
            text: button.text,
            link: button.link,
            target: button.target,
            variant: loop.first ? 'primary' : 'outlined'
          } only %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endif %}
