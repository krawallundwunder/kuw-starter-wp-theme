{% extends 'templates/_document.twig' %}

{% block content %}
	<article
		class="container mx-auto py-16 px-4">

		{# Hero Bereich mit Bild #}
		{% set imageId = post.meta('image') ?: post.thumbnail.id %}

		{% if imageId %}
			<div class="aspect-video mb-8 rounded-xl overflow-hidden shadow-lg">
				<img src="{{ Image(imageId).src }}" srcset="{{ Image(imageId).srcset }}" alt="{{ post.title }}" class="w-full h-full object-cover">
			</div>
		{% endif %}

		{# Titel & Meta #}
		<header class="mb-8">
			<div
				class="flex items-center justify-between gap-4 mb-4">
				{# Tagline #}
				{% if post.meta('tagline') %}
					<span class="bg-primary text-white px-3 py-1 rounded-full text-sm uppercase font-medium">
						{{ post.meta('tagline') }}
					</span>
				{% endif %}

				{# Datum #}
				{% if post.date %}
					<time datetime="{{ post.date }}" class="text-gray-500 text-sm ml-auto">
						{{ post.date|date("d.m.Y") }}
					</time>
				{% endif %}
			</div>

			<h1 class="text-4xl md:text-5xl font-bold text-gray-900">
				{{ post.meta('title') ?: post.title }}
			</h1>
		</header>

		{# Projekt Beschreibung #}
		<div class="prose prose-lg max-w-none mb-12">
			{% if post.meta('description') %}
				<p class="text-xl text-gray-600 leading-relaxed">
					{{ post.meta('description') }}
				</p>
			{% endif %}

			{# Hauptinhalt vom WordPress Editor #}
			{% if post.content %}
				<div class="mt-8">
					{{ post.content }}
				</div>
			{% endif %}
		</div>

		{# Zurück-Button #}
		<div class="mt-12 pt-8 border-t border-gray-200">
			<a href="javascript:history.back()" class="inline-flex items-center text-primary hover:underline font-medium">
				← Zurück zur Übersicht
			</a>
		</div>

	</article>
{% endblock %}
