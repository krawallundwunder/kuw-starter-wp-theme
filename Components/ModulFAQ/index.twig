<flynt-component name="ModulFAQ">
  <section class="py-12 sm:py-20">
    <div class="container">
      {# Header Section #}
      <div class="mb-12 text-center">
        {% include 'templates/_partials/globalHeading.twig' with {
          tag,
          title,
          description
        } %}
      </div>

      {% if faqItems %}
        {% if layoutType == 'layout-2' %}
          {# Layout 2: Accordion Style #}
          <div class="mx-auto flex max-w-4xl flex-col border-t border-gray-200">
            {% for item in faqItems %}
              <details class="group border-b border-gray-200" id="faq-{{ loop.index0 }}">
                <summary
                  class="flex cursor-pointer list-none items-start justify-between p-6 transition-colors"
                >
                  <div class="flex items-start">
                    <iconify-icon
                      icon="lucide:circle-question-mark"
                      class="text-primary mr-2 align-middle text-2xl transition-transform"
                      aria-hidden="true"
                    ></iconify-icon>
                    <span class="text-lg font-medium text-gray-900">{{ item.question }}</span>
                  </div>

                  {# Icon Toggle (Rotates when open) #}
                  <iconify-icon
                    icon="lucide:plus"
                    class="text-primary ml-4 shrink-0 align-middle text-2xl transition-transform group-open:rotate-45 group-open:text-gray-400"
                    aria-hidden="true"
                  ></iconify-icon>
                </summary>
                <div class="px-6 pb-6 pl-8 leading-relaxed text-gray-600">
                  <div class="pl-9">
                    {{ item.answer|raw }}
                  </div>
                </div>
              </details>
            {% endfor %}
          </div>
        {% else %}
          {# Layout 1: Grid Style #}
          <div class="grid gap-6 {{ gridClass }}">
            {% for item in faqItems %}
              <div class="bg-primary/10 border-primary rounded-lg border p-6 shadow-sm">
                <div class="flex items-start text-gray-900">
                  <iconify-icon
                    icon="lucide:circle-question-mark"
                    class="text-primary mr-2 align-middle text-2xl transition-transform"
                    aria-hidden="true"
                  ></iconify-icon>
                  <h3 class="text-lg font-semibold">{{ item.question }}</h3>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}
    </div>
  </section>
</flynt-component>
