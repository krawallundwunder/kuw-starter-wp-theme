<flynt-component name="ModulContactLocation">
  <section class="bg-white">
    <div class="container mx-auto px-4 py-16">
      {% if layoutVariant == 'contactOnly' %}
        {# Header #}
        <div class="mb-12">
          {% include 'templates/_partials/globalHeading.twig' with {
            tag,
            title,
            description,
            textAlign
          } %}
        </div>

        {# Standorte Section #}
        {% if locationsList and (locationsList|length) > 0 %}
          <div class="mb-20">
            {% set locationsGridClasses = 'grid gap-8 lg:gap-12 ' %}
            {% if locationsLayout == '4' %}
              {% set locationsGridClasses = locationsGridClasses
                ~ 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4'
              %}
            {% elseif locationsLayout == '3' %}
              {% set locationsGridClasses = locationsGridClasses
                ~ 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3'
              %}
            {% else %}
              {% set locationsGridClasses = locationsGridClasses ~ 'grid-cols-1 md:grid-cols-2' %}
            {% endif %}

            <div class="{{ locationsGridClasses }}">
              {% for location in locationsList %}
                {% if location.city or location.street %}
                  <div
                    class="hover:border-primary rounded-lg border border-gray-200 bg-white p-8 transition-all duration-300 hover:shadow-lg"
                  >
                    {% if location.city %}
                      <h3 class="mb-6 text-2xl font-medium text-gray-900">{{ location.city }}</h3>
                    {% endif %}

                    {% if location.street or location.zip or location.cityName %}
                      <div class="mb-6 space-y-2 text-gray-600">
                        {% if location.street %}
                          <p class="text-base">
                            {{ location.street }}
                          </p>
                        {% endif %}
                        {% if location.zip or location.cityName %}
                          <p class="text-base">
                            {% if location.zip %}
                              {{ location.zip }}
                            {% endif %}
                            {% if location.cityName %}
                              {{ location.cityName }}
                            {% endif %}
                            {% if location.country %}
                              ,
                              {{ location.country }}
                            {% endif %}
                          </p>
                        {% endif %}
                      </div>
                    {% endif %}

                    {% if location.mapLink %}
                      <a
                        href="{{ location.mapLink }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-primary hover:text-primary-dark group inline-flex items-center font-semibold transition-colors"
                      >
                        <iconify-icon
                          icon="lucide:map-pin"
                          class="mr-2 h-5 w-5 text-current"
                          aria-hidden="true"
                        ></iconify-icon>Auf Karte anzeigen
                      </a>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}

        {# Kontakt Section #}
        {% if contactAreas and (contactAreas|length) > 0 %}
          <div>
            {% set contactGridClasses = 'grid gap-8 lg:gap-12 ' %}
            {% if contactLayout == '4' %}
              {% set contactGridClasses = contactGridClasses
                ~ 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4'
              %}
            {% elseif contactLayout == '3' %}
              {% set contactGridClasses = contactGridClasses
                ~ 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3'
              %}
            {% else %}
              {% set contactGridClasses = contactGridClasses ~ 'grid-cols-1 md:grid-cols-2' %}
            {% endif %}

            <div class="{{ contactGridClasses }}">
              {% for area in contactAreas %}
                {% if area.title or area.email or area.phone or area.formLink %}
                  <div
                    class="rounded-lg bg-gray-50 p-8 transition-shadow duration-300 hover:shadow-lg"
                  >
                    <div class="flex h-full flex-col">
                      {% if area.title %}
                        <h3 class="mb-4 text-2xl font-medium text-gray-900">{{ area.title }}</h3>
                      {% endif %}

                      <div class="grow space-y-3">
                        {% if area.email %}
                          <a
                            href="mailto:{{ area.email }}"
                            class="flex items-center font-medium text-gray-700 transition-colors hover:text-gray-900"
                          >
                            <iconify-icon
                              icon="lucide:mail"
                              class="mr-2 h-4 w-4 text-current"
                              aria-hidden="true"
                            ></iconify-icon>
                            {{ area.email }}
                          </a>
                        {% endif %}

                        {% if area.phone %}
                          <a
                            href="tel:{{ area.phone|replace({
                              ' ': '',
                              '(': '',
                              ')': '',
                              '-': ''
                            }) }}"
                            class="flex items-center text-gray-600 transition-colors hover:text-gray-800"
                          >
                            <iconify-icon
                              icon="lucide:phone"
                              class="mr-2 h-4 w-4 text-current"
                              aria-hidden="true"
                            ></iconify-icon>
                            {{ area.phone }}
                          </a>
                        {% endif %}
                      </div>

                      {% if area.formLink %}
                        <div class="mt-6">
                          <a
                            href="{{ area.formLink.url }}"
                            class="text-primary hover:text-primary-dark group inline-flex items-center font-semibold transition-colors"
                            target="{{ area.formLink.target }}"
                          >
                            {{ area.formLink.title|default('Kontaktformular') }}
                            <iconify-icon
                              icon="lucide:arrow-right"
                              class="ml-2 h-5 w-5 transform text-current transition-transform group-hover:translate-x-1"
                              aria-hidden="true"
                            ></iconify-icon>
                          </a>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% else %}
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
          {# Left Column - Header & Location Cards #}
          <div class="space-y-8">
            <div>
              {% include 'templates/_partials/globalHeading.twig' with {
                tag,
                title,
                description,
                textAlign
              } %}
            </div>

            {# Location Cards #}
            {% if (locations|length) > 0 %}
              <div class="space-y-6">
                {% for location in locations %}
                  {% if location.name or location.street %}
                    <div
                      class="rounded-lg border border-gray-100 bg-gray-50 p-6 transition-shadow duration-300 hover:shadow-lg"
                    >
                      {# Location Name #}
                      {% if location.name %}
                        <h3 class="mb-3 text-xl font-semibold text-gray-900">
                          {{ location.name }}
                        </h3>
                      {% endif %}

                      {# Address Block #}
                      {% if location.street or location.zip or location.city or location.country %}
                        <div class="mb-4 space-y-1 border-b border-gray-200 pb-4 text-gray-600">
                          {% if location.street %}
                            <p class="text-base">
                              {{ location.street }}
                            </p>
                          {% endif %}
                          {% if location.zip or location.city %}
                            <p class="text-base">
                              {% if location.zip %}
                                {{ location.zip }}
                              {% endif %}
                              {% if location.city %}
                                {{ location.city }}
                              {% endif %}
                              {% if location.country %}
                                ,
                                {{ location.country }}
                              {% endif %}
                            </p>
                          {% endif %}
                        </div>
                      {% endif %}

                      {# Contact Details #}
                      <div class="space-y-2">
                        {% if location.email %}
                          <a
                            href="mailto:{{ location.email }}"
                            class="group flex items-center text-gray-700 transition-colors hover:text-gray-900"
                          >
                            <iconify-icon
                              icon="lucide:mail"
                              class="mr-2 h-4 w-4 text-current"
                              aria-hidden="true"
                            ></iconify-icon>
                            <span class="text-sm font-medium">{{ location.email }}</span>
                          </a>
                        {% endif %}
                        {% if location.phone %}
                          <a
                            href="tel:{{ location.phone|replace({
                              ' ': '',
                              '(': '',
                              ')': '',
                              '-': ''
                            }) }}"
                            class="group flex items-center text-gray-700 transition-colors hover:text-gray-900"
                          >
                            <iconify-icon
                              icon="lucide:phone"
                              class="mr-2 h-4 w-4 text-current"
                              aria-hidden="true"
                            ></iconify-icon>
                            <span class="text-sm font-medium">{{ location.phone }}</span>
                          </a>
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          </div>

          {# Right Column - Contact Form #}
          <div class="sticky top-8 h-fit rounded-lg bg-gray-50 p-8 lg:p-10">
            <h3 class="mb-6 text-2xl font-semibold text-gray-900">Kontaktformular</h3>
            {% include 'templates/_partials/contactForm.twig' with {
              formId: 'contactForm'
            } %}
          </div>
        </div>
      {% endif %}
    </div>
  </section>
</flynt-component>
